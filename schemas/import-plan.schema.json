{
  "$defs": {
    "portableId": {
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "type": "string"
    },
    "relativePath": {
      "minLength": 1,
      "not": {
        "pattern": "^(?:/|[A-Za-z]:[\\\\/])"
      },
      "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$)).+$",
      "type": "string"
    }
  },
  "$id": "https://offline-game-vault.invalid/schemas/import-plan-v4.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "contract": {
      "const": "ogv-import-plan-v4"
    },
    "documentation": {
      "items": {
        "properties": {
          "canonical_name": {
            "minLength": 1,
            "pattern": "^[^/\\\\]+$",
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "id": {
            "$ref": "#/$defs/portableId"
          },
          "role": {
            "enum": [
              "readme",
              "game_sheet",
              "credits",
              "preserved_by",
              "technical_notes",
              "addendum",
              "other"
            ]
          },
          "source_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "workspace_path": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "role",
          "canonical_name"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "identity": {
      "properties": {
        "appid": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        },
        "capsule_id": {
          "$ref": "#/$defs/portableId"
        },
        "edition": {
          "type": [
            "string",
            "null"
          ]
        },
        "preserved_version": {
          "minLength": 1,
          "type": "string"
        },
        "source_store": {
          "minLength": 1,
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "title",
        "source_store",
        "preserved_version",
        "capsule_id"
      ],
      "type": "object"
    },
    "layout": {
      "properties": {
        "entrypoint": {
          "$ref": "#/$defs/relativePath"
        },
        "game_destination_in_prefix": {
          "$ref": "#/$defs/relativePath"
        },
        "working_directory": {
          "$ref": "#/$defs/relativePath"
        }
      },
      "required": [
        "game_destination_in_prefix",
        "entrypoint",
        "working_directory"
      ],
      "type": "object"
    },
    "persistent_state": {
      "properties": {
        "baseline_state": {
          "enum": [
            "clean",
            "embedded-or-unknown"
          ]
        },
        "items": {
          "items": {
            "properties": {
              "disposition": {
                "enum": [
                  "save-set",
                  "identity",
                  "configuration",
                  "exclude",
                  "embedded",
                  "unbound"
                ]
              },
              "id": {
                "$ref": "#/$defs/portableId"
              },
              "kind": {
                "enum": [
                  "save",
                  "identity",
                  "configuration",
                  "cache",
                  "log",
                  "temporary",
                  "other"
                ]
              },
              "path": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "required": {
                "type": "boolean"
              },
              "save_set_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "sensitive": {
                "type": "boolean"
              },
              "source_path": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "workspace_path": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "id",
              "disposition"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "unclassified_candidates": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "items",
        "unclassified_candidates",
        "baseline_state"
      ],
      "type": "object"
    },
    "policy": {
      "type": "object"
    },
    "profiles": {
      "items": {
        "properties": {
          "adapter": {
            "const": "other"
          },
          "enabled": {
            "const": true
          },
          "id": {
            "const": "game-source"
          },
          "platform": {
            "const": "linux"
          },
          "status": {
            "const": "candidate"
          }
        },
        "required": [
          "id",
          "adapter",
          "platform",
          "status",
          "enabled"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    },
    "runner": {
      "properties": {
        "binding": {
          "const": "select-at-materialization"
        },
        "preferred_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "pattern": "^(?:sha256:)?[0-9a-f]{64}$",
          "type": [
            "string",
            "null"
          ]
        },
        "source_path": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "binding"
      ],
      "type": "object"
    },
    "schema": {
      "const": 0
    },
    "source": {
      "properties": {
        "game_directory": {
          "type": [
            "string",
            "null"
          ]
        },
        "legitimate_source": {
          "const": true
        },
        "preparation": {
          "properties": {
            "performed_before_import": {
              "const": true
            }
          },
          "required": [
            "performed_before_import"
          ],
          "type": "object"
        },
        "steam_independent": {
          "const": true
        },
        "store_client_independent": {
          "const": true
        },
        "third_party_drm": {
          "const": "declared-absent"
        },
        "type": {
          "const": "prepared-offline-game-directory-v1"
        }
      },
      "required": [
        "type",
        "store_client_independent",
        "steam_independent",
        "legitimate_source",
        "third_party_drm",
        "preparation"
      ],
      "type": "object"
    },
    "supplemental_content": {
      "items": {
        "properties": {
          "placement": {
            "additionalProperties": false,
            "properties": {
              "destination": {
                "minLength": 1,
                "type": "string"
              },
              "mode": {
                "enum": [
                  "game-overlay",
                  "sidecar"
                ],
                "type": "string"
              }
            },
            "required": [
              "mode",
              "destination"
            ],
            "type": "object"
          },
          "classification": {
            "minLength": 1,
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "id": {
            "$ref": "#/$defs/portableId"
          },
          "source_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "workspace_path": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "classification"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "schema",
    "contract",
    "source",
    "identity",
    "layout",
    "runner",
    "persistent_state",
    "supplemental_content",
    "documentation",
    "profiles",
    "policy"
  ],
  "title": "OfflineGameVault Prepared Game Import Plan v4",
  "type": "object"
}
