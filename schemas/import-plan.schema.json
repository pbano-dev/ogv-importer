{
  "$defs": {
    "relativePath": {
      "minLength": 1,
      "not": {
        "pattern": "^(?:/|[A-Za-z]:[\\\\/])"
      },
      "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$)).+$",
      "type": "string"
    }
  },
  "$id": "https://offline-game-vault.invalid/schemas/import-plan-v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "contract": {
      "const": "ogv-import-plan-v2"
    },
    "identity": {
      "additionalProperties": true,
      "properties": {
        "appid": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        },
        "capsule_id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "type": "string"
        },
        "edition": {
          "type": [
            "string",
            "null"
          ]
        },
        "preserved_version": {
          "minLength": 1,
          "type": "string"
        },
        "source_store": {
          "minLength": 1,
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "title",
        "source_store",
        "preserved_version",
        "capsule_id"
      ],
      "type": "object"
    },
    "layout": {
      "additionalProperties": true,
      "properties": {
        "entrypoint": {
          "$ref": "#/$defs/relativePath"
        },
        "game_destination_in_prefix": {
          "$ref": "#/$defs/relativePath"
        },
        "working_directory": {
          "$ref": "#/$defs/relativePath"
        }
      },
      "required": [
        "game_destination_in_prefix",
        "entrypoint",
        "working_directory"
      ],
      "type": "object"
    },
    "persistent_state": {
      "additionalProperties": true,
      "properties": {
        "baseline_state": {
          "enum": [
            "clean",
            "embedded-or-unknown"
          ]
        },
        "items": {
          "items": {
            "additionalProperties": true,
            "properties": {
              "disposition": {
                "enum": [
                  "save-set",
                  "identity",
                  "configuration",
                  "exclude",
                  "embedded",
                  "unbound"
                ]
              },
              "id": {
                "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
                "type": "string"
              },
              "kind": {
                "enum": [
                  "save",
                  "identity",
                  "configuration",
                  "cache",
                  "log",
                  "temporary",
                  "other"
                ]
              },
              "path": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "required": {
                "type": "boolean"
              },
              "save_set_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "sensitive": {
                "type": "boolean"
              },
              "source_path": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "id",
              "disposition"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "unclassified_candidates": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "items",
        "unclassified_candidates",
        "baseline_state"
      ],
      "type": "object"
    },
    "policy": {
      "type": "object"
    },
    "profiles": {
      "items": {
        "additionalProperties": true,
        "properties": {
          "adapter": {
            "enum": [
              "bottles",
              "wine",
              "windows",
              "umu",
              "other"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "id": {
            "type": "string"
          },
          "platform": {
            "enum": [
              "linux",
              "windows"
            ]
          },
          "status": {
            "enum": [
              "verified",
              "candidate",
              "experimental",
              "not_tested",
              "unavailable"
            ]
          }
        },
        "required": [
          "id",
          "adapter",
          "platform",
          "status",
          "enabled"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "runner": {
      "additionalProperties": true,
      "properties": {
        "binding": {
          "enum": [
            "select-at-materialization",
            "preferred",
            "fixed",
            "none"
          ]
        },
        "preferred_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "pattern": "^(?:sha256:)?[0-9a-f]{64}$",
          "type": [
            "string",
            "null"
          ]
        },
        "source_path": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "binding"
      ],
      "type": "object"
    },
    "schema": {
      "const": 0
    },
    "status": {
      "type": "string"
    },
    "supplemental_content": {
      "items": {
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "schema",
    "contract",
    "identity",
    "layout",
    "runner",
    "persistent_state",
    "profiles",
    "policy"
  ],
  "title": "OfflineGameVault Import Plan v2",
  "type": "object"
}
